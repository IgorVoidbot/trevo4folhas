# TREVO4FOLHAS — exemplo de configuração de ambiente (APENAS placeholders).
#
# Copie para .env (ignorado pelo git) e preencha com valores reais de
# desenvolvimento. Nunca versione .env: segredos reais ficam fora do
# repositório, no runtime/gerenciador de segredos aprovado (PRD 8.6).
# O docker-compose.yml lê este arquivo automaticamente; alternativamente use
# `docker compose --env-file <arquivo>`.
#
# Compartilhamento consistente: o serviço `db` recebe POSTGRES_* e o serviço
# `app` recebe DB_URL (hostname interno `db`), DB_USERNAME e DB_PASSWORD
# derivados desses mesmos valores pelo próprio compose. Dentro do container a
# aplicação nunca acessa o banco por localhost.

# --- Banco de dados (serviço db) ---
POSTGRES_DB=YOUR_DATABASE_NAME_HERE
POSTGRES_USER=YOUR_DATABASE_USER_HERE
POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD_HERE
# Optional host port if another local PostgreSQL already uses 5432:
# POSTGRES_PORT=5433

# Execução da aplicação fora do compose (./mvnw spring-boot:run no host, perfil
# local): a aplicação lê DB_URL, DB_USERNAME e DB_PASSWORD do ambiente. Exemplo
# de valor para o host — nunca usar localhost dentro do container:
# DB_URL=jdbc:postgresql://localhost:5432/YOUR_DATABASE_NAME_HERE
# DB_USERNAME=YOUR_DATABASE_USER_HERE
# DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

# --- Regras de negócio da banca (PRD 8.6) ---
# Número público da banca (não é segredo; valor real definido no produto).
BANK_WHATSAPP_NUMBER=YOUR_BANK_WHATSAPP_NUMBER_HERE
# Zona da banca para exibição de datas, ex.: America/Sao_Paulo.
BANK_TIME_ZONE=YOUR_BANK_TIME_ZONE_HERE
MIN_STAKE_AMOUNT=YOUR_MIN_STAKE_AMOUNT_HERE
MAX_STAKE_AMOUNT=YOUR_MAX_STAKE_AMOUNT_HERE
MAX_SELECTIONS=YOUR_MAX_SELECTIONS_HERE
MAX_POTENTIAL_RETURN=YOUR_MAX_POTENTIAL_RETURN_HERE
TICKET_VALIDITY_MINUTES=YOUR_TICKET_VALIDITY_MINUTES_HERE

# --- Integração de dados esportivos (etapa 028, NÃO habilitada) ---
# As variáveis do adapter (SPORTS_DATA_*, API_FOOTBALL_API_KEY, etc.) seguem o
# PRD 8.6 e só entram em configuração quando a etapa 028 for autorizada com
# credencial, orçamento e política. Nenhum placeholder de chave é usado aqui.
